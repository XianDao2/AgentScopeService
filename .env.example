# 服务配置
APP_NAME=ms3
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# 数据库配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ruoyi-ai-agent
MYSQL_POOL_SIZE=50
MYSQL_MAX_OVERFLOW=30

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Qdrant配置
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# MongoDB配置
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=root
MONGO_DB=ms3_logs

# MinIO配置
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=ms3-files

# JWT配置
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 阿里云百炼配置
DASHSCOPE_API_KEY=your-dashscope-api-key

# AgentScope配置
LLM_GLOBAL_MAX_CONCURRENCY=200
UVICORN_WORKERS=4
WORKSPACE_BASE_DIR=/data/workspaces

# 限流配置
TENANT_MAX_CONCURRENT_DEFAULT=50
GLOBAL_MAX_CONCURRENT=300
