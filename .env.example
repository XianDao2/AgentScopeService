# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=ruoyi-ai-agent
MYSQL_POOL_SIZE=50
MYSQL_MAX_OVERFLOW=30

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant
QDRANT_URL=http://qdrant:6333

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=root

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ms3

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=1440

# DashScope
DASHSCOPE_API_KEY=

# Concurrency
LLM_GLOBAL_MAX_CONCURRENCY=200
UVICORN_WORKERS=4

# Workspace
WORKSPACE_BASEDIR=/data/workspaces
WORKSPACE_TTL=3600

# Server
HOST=0.0.0.0
PORT=8080
